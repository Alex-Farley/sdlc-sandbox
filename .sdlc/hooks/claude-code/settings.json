{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(/.sdlc/**)",
      "Edit(/.claude/**)",
      "Edit(/.codex/**)",
      "Edit(/.gemini/**)",
      "Edit(/.agents/**)",
      "Edit(/.github/**)",
      "Edit(/scripts/sdlc)",
      "Edit(/scripts/github-protect.sh)",
      "Edit(/CLAUDE.md)",
      "Edit(/REVIEW.md)",
      "Edit(/maintain/runbooks/**)",
      "Edit(**/.gitattributes)",
      "Bash(git config user*)",
      "Bash(git config core*)",
      "Bash(git config gpg*)",
      "Bash(git -c *)",
      "Bash(git commit -n *)",
      "Bash(git commit --no-verify *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(scripts/sdlc approve *)",
      "Bash(scripts/sdlc unlock-test *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(/AGENTS.md)",
      "Edit(/evals/run.sh)",
      "Bash(gh api *)",
      "Bash(gh alias *)",
      "Bash(gh extension *)",
      "Bash(gh auth *)",
      "Bash(gh workflow *)",
      "Bash(git commit-tree *)",
      "Bash(git update-ref *)",
      "Bash(git update-index *)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh pr create *",
      "gh pr view *",
      "gh pr checks *",
      "gh pr diff *",
      "gh pr list *",
      "gh pr comment *",
      "gh pr status *"
    ],
    "filesystem": {
      "denyRead": [
        "./.env",
        "~/.ssh",
        "~/.aws"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "rubygems.org"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.sdlc/hooks/agent-guard.py\" || { echo 'sdlc guard did not run cleanly - blocking to be safe' >&2; exit 2; }"
          }
        ]
      }
    ]
  }
}
